# Copy this file to .env and customize paths for your machine.
OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=
# Defaults assume the external project directories are siblings of this repo.
OBJECT_DETECTION_DIR=
LAE_DINO_ROOT=
LAE_CONFIG_FILE=
LAE_BERT_DIR=
LAE_CHECKPOINT=
DET_DEVICE=cpu
SEGEARTH_ROOT=
SAM3_CHECKPOINT=
SEG_DEVICE=
# Required for automatic SAM 3 downloads after accepting the model's terms.
HF_TOKEN=
LAE_ENV_NAME=LAE
SAM_ENV_NAME=SAM
UNIBUILD_ENV_NAME=geopython
# Optional full interpreter paths override env discovery:
LAE_PYTHON=
SAM_PYTHON=
UNIBUILD_PYTHON=
# UniBuild code and separately downloaded checkpoint.
UNIBUILD_ROOT=
UNIBUILD_REPO=
UNIBUILD_CHECKPOINT=
UNIBUILD_DEVICE=
UNIBUILD_THRESHOLD=0.5
UNIBUILD_BATCH_SIZE=0
UNIBUILD_MIN_AREA_PX=9
UNIBUILD_CONNECTIVITY=8
# V4 Delineate Anything V2 (separate Python environment with GDAL)
# DELINEATE_PYTHON=D:\path\to\delineate\python.exe
DELINEATE_ROOT=
DELINEATE_UPSTREAM=
DELINEATE_CHECKPOINT=
DELINEATE_CONFIDENCE=0.15
DELINEATE_REMAINING_AREA=0.35
DELINEATE_MIN_AREA_PX=128
DELINEATE_BATCH_SIZE=2
DELINEATE_POST_WORKERS=1
DELINEATE_TIMEOUT=900
FIELD_NONAG_REJECT_FRACTION=0.70
FIELD_CROPLAND_SUPPORT_FRACTION=0.40
RGB_BANDS=1,2,3
# Bounded field review; source geometry remains local and is never truncated.
VLM_FIELD_BATCH_SIZE=64
VLM_FIELD_TEXT_BUDGET=32000
VLM_FIELD_IMAGE_MAX_SIDE=1024
VLM_FIELD_MIN_IMAGE_SIDE=256
VLM_FIELD_CROP_PADDING=96
